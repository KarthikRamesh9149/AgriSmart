{
  "name": "agri-intelligence",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Agri Intelligence Dashboard - Agricultural insights for India",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint client/src server/src scripts eslint.config.js",
    "audit": "npm audit",
    "ci": "npm run lint && npm test --workspaces --if-present && npm run build",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^8.2.2",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.60.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@11.9.0"
}
