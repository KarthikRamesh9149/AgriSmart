# Server Configuration
PORT=8787
NODE_ENV=development
LOG_LEVEL=debug
CLIENT_ORIGINS=http://localhost:5173

# Safe by default: disabled guarantees zero provider calls even when keys exist.
AI_MODE=disabled

# Demo mode with a blank token creates a request-local demo actor. For any shared
# deployment use AUTH_MODE=token and a JSON token map (keep the real value secret).
AUTH_MODE=demo
DEMO_API_TOKEN=
AUTH_TOKENS_JSON=

# In-process per-actor and per-tenant provider reservations (reset on restart).
AI_ACTOR_REQUEST_LIMIT=10
AI_TENANT_REQUEST_LIMIT=50
AI_ACTOR_COST_LIMIT_USD=0.25
AI_TENANT_COST_LIMIT_USD=1.00

# Mistral API Keys (Feature-specific, server-side only)
MISTRAL_FEATURE1_KEY=
MISTRAL_FEATURE1_MODEL=mistral-small-latest
MISTRAL_FEATURE2_KEY=
MISTRAL_FEATURE2_MODEL=mistral-small-latest
MISTRAL_FEATURE3_KEY=
MISTRAL_FEATURE3_MODEL=mistral-large-latest
MISTRAL_FEATURE4_KEY=
MISTRAL_FEATURE4_MODEL=mistral-large-latest
MISTRAL_BRIEF_KEY=
MISTRAL_BRIEF_MODEL=mistral-medium-latest
